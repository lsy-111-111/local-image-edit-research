{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raw Page",
  "type": "object",
  "required": ["page_id", "source_url", "source_type", "retrieved_at", "content_sha256"],
  "properties": {
    "page_id": {"type": "string"},
    "source_url": {"type": "string"},
    "source_type": {
      "enum": [
        "official_docs",
        "official_api_docs",
        "official_model_card",
        "official_github",
        "paper",
        "release_note"
      ]
    },
    "retrieved_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "title": {"type": "string"},
    "text": {"type": "string"},
    "saved_path": {"type": "string"},
    "content_sha256": {"type": "string"}
  },
  "additionalProperties": true
}
