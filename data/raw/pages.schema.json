{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raw Page",
  "type": "object",
  "required": ["page_id", "source_url", "source_type", "retrieved_at", "text"],
  "properties": {
    "page_id": {"type": "string"},
    "source_url": {"type": "string"},
    "source_type": {
      "enum": [
        "official_documentation",
        "official_api_reference",
        "official_model_card",
        "official_paper_page",
        "paper",
        "provider_documentation",
        "provider_model_page",
        "unknown"
      ]
    },
    "retrieved_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "title": {"type": "string"},
    "text": {"type": "string"}
  },
  "additionalProperties": true
}
