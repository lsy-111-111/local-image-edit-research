{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architecture Labels",
  "type": "object",
  "required": ["model_id", "base_architecture", "control_mechanism", "training_or_inference", "deployment", "architecture_public"],
  "properties": {
    "model_id": {"type": "string"},
    "base_architecture": {"type": "string"},
    "control_mechanism": {"type": "string"},
    "training_or_inference": {"type": "string"},
    "deployment": {"type": "string"},
    "architecture_public": {"enum": ["public", "partial", "unknown"]},
    "source_url": {"type": "string"},
    "evidence_quote": {"type": "string"},
    "evidence_level": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5", ""]},
    "last_verified_date": {"type": "string"},
    "review_status": {"type": "string"}
  },
  "additionalProperties": true
}
